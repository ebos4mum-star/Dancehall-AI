# PLACEHOLDERS ONLY. Copy to .env.local (git-ignored) and fill in real values locally.
# This repository is PUBLIC: never commit real keys, tokens or passwords.

# --- Mobile app (EXPO_PUBLIC_* values ship inside the app binary: public values only) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_APP_ENV=development

# --- Server-side only (Edge Function secrets; never in the app, never in git) ---
# Not used in Phase 0B. Listed so the names are agreed in advance.
ANTHROPIC_API_KEY=
AI_PROVIDER=mock
AI_MONTHLY_BUDGET_USD=50
SUPABASE_SERVICE_ROLE_KEY=
REVENUECAT_WEBHOOK_SECRET=
